{
  "name": "@gabrielahn/gtfs-tools",
  "version": "1.6.0",
  "description": "GTFS command-line tools: import feeds (local, http(s), s3, r2), browse stations/stops/routes/pathways, edit connections, trips and schedules, compare service and export from the terminal with DuckDB and the gtfs extension, plus a local browser dashboard",
  "license": "MIT",
  "author": "Gabriel AHN",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielAHN/gtfs-tools.git"
  },
  "homepage": "https://gtfs-viz-production-f1a4.up.railway.app/docs/gtfs-tools/cli/",
  "bugs": {
    "url": "https://github.com/gabrielAHN/gtfs-tools/issues"
  },
  "keywords": [
    "gtfs",
    "gtfs-tools",
    "transit",
    "duckdb",
    "cli",
    "visualization",
    "stations",
    "stops",
    "routes",
    "pathways",
    "accessibility",
    "schedules",
    "export"
  ],
  "bin": {
    "gtfs-tools": "dist/index.js"
  },
  "files": [
    "dist",
    "dashboard",
    "skills",
    "scripts",
    "README.md"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:cli": "tsc -p tsconfig.json && node scripts/bundle.mjs && chmod +x dist/index.js",
    "dashboard": "node scripts/build-dashboard.mjs",
    "build": "npm run build:cli && npm run dashboard",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "preuninstall": "node scripts/preuninstall.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "esbuild": "^0.28.0",
    "typescript": "~5.6.2"
  }
}
